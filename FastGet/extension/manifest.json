{
  "manifest_version": 3,
  "name": "FastGet Integration",
  "version": "1.0.0",
  "description": "Send downloads and streaming videos to the FastGet download manager.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "permissions": ["downloads", "cookies", "contextMenus", "nativeMessaging", "webRequest", "tabs", "storage"],
  "host_permissions": ["<all_urls>"]
}
