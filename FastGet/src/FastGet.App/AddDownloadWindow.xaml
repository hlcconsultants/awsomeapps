<Window x:Class="FastGet.App.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add download" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        Icon="app.ico" Style="{StaticResource Base}" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="18">
        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Link"/>
        <TextBox x:Name="UrlBox" Style="{StaticResource Field}"/>

        <TextBlock Style="{StaticResource Label}" Text="File name (optional)"/>
        <TextBox x:Name="NameBox" Style="{StaticResource Field}"/>

        <TextBlock Style="{StaticResource Label}" Text="Save to (blank = sort into folders by file type)"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Tool}" Content="Browse…" Click="Browse_Click"/>
            <TextBox x:Name="DirBox" Style="{StaticResource Field}"/>
        </DockPanel>

        <TextBlock Style="{StaticResource Label}" Text="Connections"/>
        <ComboBox x:Name="ConnBox" Width="90" HorizontalAlignment="Left"/>

        <TextBlock x:Name="ErrorText" Foreground="#B91C1C" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Tool}" Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource Tool}" Content="Download later" Click="Later_Click"/>
            <Button Style="{StaticResource Primary}" Content="Download" IsDefault="True" Click="Start_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
