<Window x:Class="FastGet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FastGet" Height="620" Width="1120" MinHeight="400" MinWidth="760"
        Icon="app.ico" Style="{StaticResource Base}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <TextBox x:Name="Search" DockPanel.Dock="Right" Width="200" Style="{StaticResource Field}" VerticalContentAlignment="Center"
                         ToolTip="Search downloads" TextChanged="Search_TextChanged"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Primary}" Content="+ Add URL" Click="Add_Click"/>
                    <Button Style="{StaticResource Tool}" Content="Resume" Click="Resume_Click"/>
                    <Button Style="{StaticResource Tool}" Content="Pause" Click="Pause_Click"/>
                    <Button Style="{StaticResource Tool}" Content="Remove" Click="Remove_Click"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>
                    <Button Style="{StaticResource Tool}" Content="Resume all" Click="ResumeAll_Click"/>
                    <Button Style="{StaticResource Tool}" Content="Pause all" Click="PauseAll_Click"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>
                    <Button Style="{StaticResource Tool}" Content="Settings" Click="Settings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,5" Background="{StaticResource Panel}">
            <DockPanel>
                <TextBlock x:Name="Speed" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                <TextBlock x:Name="Summary" Foreground="{StaticResource Muted}"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Filters" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Line}" Background="{StaticResource Panel}"
                     Padding="4,6" SelectionChanged="Filters_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,7"/></Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <DataGrid x:Name="Grid" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" BorderThickness="0" Background="White" RowHeight="32"
                      SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"
                      MouseDoubleClick="Grid_MouseDoubleClick" KeyDown="Grid_KeyDown">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter Property="Padding" Value="8,7"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="8,0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Resume" Click="Resume_Click"/>
                        <MenuItem Header="Pause" Click="Pause_Click"/>
                        <MenuItem Header="Download again" Click="Restart_Click"/>
                        <Separator/>
                        <MenuItem Header="Open file" Click="Open_Click"/>
                        <MenuItem Header="Show in folder" Click="Folder_Click"/>
                        <Separator/>
                        <MenuItem Header="Copy link" Click="Copy_Click"/>
                        <MenuItem Header="Update expired link…" Click="UpdateLink_Click"/>
                        <Separator/>
                        <MenuItem Header="Remove from list" Click="Remove_Click"/>
                        <MenuItem Header="Remove and delete file" Click="RemoveDelete_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="*" MinWidth="200" Binding="{Binding Display, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Size" Width="90" Binding="{Binding SizeText, Mode=OneWay}"/>
                    <DataGridTemplateColumn Header="Progress" Width="150" SortMemberPath="Percent">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Height="16" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                 Foreground="{StaticResource Accent}" Background="#E5E7EB" BorderThickness="0"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                               Text="{Binding Percent, Mode=OneWay, StringFormat={}{0:0.0}%}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Speed" Width="95" Binding="{Binding SpeedText, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Time left" Width="80" Binding="{Binding EtaText, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Status" Width="170" Binding="{Binding StatusText, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Added" Width="125" Binding="{Binding AddedAt, Mode=OneWay, StringFormat={}{0:g}}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
